# ==============================================================================
# Tours & Travels Management System — Environment Configuration Template
# Copy this file to .env and configure your environment settings.
# ==============================================================================

APP_NAME="Tours & Travels"
APP_ENV=development
APP_DEBUG=true

# ==============================================================================
# Database Configuration
# Localhost: Use DB_USERNAME=root and empty DB_PASSWORD (if default XAMPP).
# Production: Set DB_HOST, DB_DATABASE, DB_USERNAME, DB_PASSWORD from hosting.
# ==============================================================================

DB_HOST=localhost
DB_PORT=3306
DB_DATABASE=tours_travels_db
DB_USERNAME=root
DB_PASSWORD=

# ==============================================================================
# SMTP Mail Configuration — Gmail SSL Port 465
# Generate an App Password at: https://myaccount.google.com/apppasswords
# ==============================================================================

MAIL_HOST=smtp.gmail.com
MAIL_PORT=465
MAIL_USERNAME=
MAIL_PASSWORD=
MAIL_ENCRYPTION=ssl
MAIL_FROM_ADDRESS=
MAIL_FROM_NAME="Tours & Travels"
MAIL_ADMIN_ADDRESS=
