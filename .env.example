# ==============================================================================
# VoyageGo Tours & Travels — Environment Configuration Template
# Copy this file to .env and configure your Gmail SMTP credentials.
# ==============================================================================

APP_NAME="VoyageGo Tours & Travels"
APP_ENV=production
APP_DEBUG=false

# ==============================================================================
# SMTP Mail Configuration (Gmail SSL Port 465)
# Note: Google accounts with 2-Step Verification require a 16-character App Password.
# Generate one at: https://myaccount.google.com/apppasswords
# ==============================================================================
MAIL_HOST=smtp.gmail.com
MAIL_PORT=465
MAIL_USERNAME=your-email@gmail.com
MAIL_PASSWORD=your-app-password
MAIL_ENCRYPTION=ssl
MAIL_FROM_ADDRESS=your-email@gmail.com
MAIL_FROM_NAME="VoyageGo Tours & Travels"
MAIL_ADMIN_ADDRESS=admin@voyagegotravels.com
