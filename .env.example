# ==============================================================================
# Tours & Travels Management System — Environment Configuration Template
# Copy this file to .env and configure your local/production settings.
# ==============================================================================

APP_NAME="Tours & Travels Management System"
APP_ENV=production
APP_DEBUG=false
APP_URL=http://localhost

# Database Configuration
DB_DRIVER=mysql
DB_HOST=127.0.0.1
DB_PORT=3306
DB_DATABASE=tours_travels_db
DB_USERNAME=root
DB_PASSWORD=

# ==============================================================================
# SMTP Mail Configuration (Gmail SSL Port 465 or custom SMTP)
# Note: Google accounts with 2-Step Verification require a 16-character App Password.
# Generate one at: https://myaccount.google.com/apppasswords
# ==============================================================================
MAIL_HOST=smtp.gmail.com
MAIL_PORT=465
MAIL_USERNAME=your-email@example.com
MAIL_PASSWORD=your-app-password
MAIL_ENCRYPTION=ssl
MAIL_FROM_ADDRESS=noreply@example.com
MAIL_FROM_NAME="Tours & Travels"
MAIL_ADMIN_ADDRESS=admin@example.com
